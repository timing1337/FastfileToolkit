<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.106">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ContentWithTargetPath Include="Dependencies\dobby.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>Dependencies\dobby.dll</TargetPath>
    </ContentWithTargetPath>
    <ContentWithTargetPath Include="Dependencies\oo2core_8_win64.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>Dependencies\oo2core_8_win64.dll</TargetPath>
    </ContentWithTargetPath>
	</ItemGroup>
</Project>
